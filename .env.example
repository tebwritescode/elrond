# Elrond (alternate implementation) — sanitized example environment.
# Copy to .env and adjust. Never commit a populated .env.
#
# NOTE: this build intentionally uses a port range that does not collide with
# any other Elrond implementation running on the same host.

# --- HTTP -------------------------------------------------------------------
# Address the single Rust process binds. 3100 is this build's API port.
ELROND_BIND_ADDRESS=127.0.0.1:3100

# Public origin used for absolute links and cookie scoping.
ELROND_PUBLIC_URL=http://localhost:3100

# Set to true behind TLS so session cookies are marked Secure.
ELROND_SECURE_COOKIES=false

# --- Storage ----------------------------------------------------------------
# Mounted volume holding the database, originals, derivatives, and binders.
ELROND_DATA_DIR=./dev-data

# SQLite connection string. Runs in WAL mode with foreign keys enforced.
ELROND_DATABASE_URL=sqlite://./dev-data/elrond.db?mode=rwc

# --- Limits -----------------------------------------------------------------
ELROND_MAX_UPLOAD_BYTES=268435456
ELROND_MAX_ZIP_ENTRIES=20000
ELROND_MAX_ZIP_EXPANDED_BYTES=5368709120
ELROND_MAX_ZIP_COMPRESSION_RATIO=120
ELROND_MAX_ZIP_DEPTH=32

# --- Stirling-PDF (independently deployed) ----------------------------------
# Shared external service. Responses are treated as untrusted and validated.
STIRLING_URL=http://localhost:8080
# STIRLING_API_KEY=

# --- Observability ----------------------------------------------------------
RUST_LOG=info,elrond_api=debug,elrond_server=debug,tower_http=info

# Create the first administrator at startup instead of showing the setup screen.
# Both must be set together; a no-op once any account exists. The password has
# the same 12-character minimum as the setup screen.
ELROND_ADMIN_USERNAME=
ELROND_ADMIN_PASSWORD=
